# 7.1 耐药(resfinder)基因预测
    echo -e "\n$(date '+%Y-%m-%d %H:%M:%S') 耐药基因(resfinder)预测开始"

    mkdir -p $OUTPUT_DIR/resfinder/temp
    mkdir -p $OUTPUT_DIR/resfinder/result
    mkdir -p $OUTPUT_DIR/resfinder/point
    mkdir -p $OUTPUT_DIR/resfinder/disin

    docker run --rm -v $INPUT_DIR:$INPUT_DIR -v $OUTPUT_DIR:$OUTPUT_DIR --entrypoint /bin/bash resfinder:v4.7.2 \
    -c "cd $INPUT_DIR && \
    for file in $INPUT_DIR/*.fasta ; do 
        filename=\$(basename \$file .fasta)
        mkdir $OUTPUT_DIR/resfinder/temp/\$filename
        python -m resfinder -ifa \$file -o $OUTPUT_DIR/resfinder/temp/\$filename -s "$SPECIES" --acquired --point --threshold 0.9 --min_cov 0.9 --disinfectant
        cp $OUTPUT_DIR/resfinder/temp/\$filename/ResFinder_results_tab.txt $OUTPUT_DIR/resfinder/result/\${filename}_resfinder.tab
        cp $OUTPUT_DIR/resfinder/temp/\$filename/PointFinder_results.txt $OUTPUT_DIR/resfinder/point/\${filename}_pointfinder.tab
        cp $OUTPUT_DIR/resfinder/temp/\$filename/DisinFinder_results_tab.txt $OUTPUT_DIR/resfinder/disin/\${filename}_disinfinder.tab
    done"

    echo -e "$(date '+%Y-%m-%d %H:%M:%S') 耐药基因(resfinder)预测成功"

fi

